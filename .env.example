# FocusFlow environment variables
#
# Everything here is OPTIONAL. With no variables set, FocusFlow runs in
# local-first mode (data in the browser, no accounts) and the sign-in button
# is hidden automatically.
#
# To enable "Sign in with Google", create a Firebase project, enable the
# Google sign-in provider, and paste the web-app config below. These values
# are public client identifiers — they are safe to expose in the browser.
# See README → "Google sign-in (optional)" for step-by-step setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
